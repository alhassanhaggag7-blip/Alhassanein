{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/ai",
      "dest": "/api/ai.js"
    },
    {
      "src": "/api/check-email",
      "dest": "/api/check-email.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
